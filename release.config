# Edit this file, then run scripts/make-ipa.sh (everything is optional).
BUNDLE_ID="com.knt.pzios"       # your bundle identifier; the JIT helper becomes <id>.jithelper
TEAM_ID=""                          # your Apple developer team id (10 characters); empty is fine for an ad-hoc IPA
DISPLAY_NAME="pziOS"                # the name under the icon
SIGN_IDENTITY="-"                   # "-" = ad hoc (sideloading tools re-sign it). Or a certificate hash/name from: security find-identity -v -p codesigning
PROFILE_APP=""                      # optional: .mobileprovision files for the app and for the JIT helper. With them (and a real identity) the IPA is signed for
PROFILE_JIT=""                      #           your devices directly; their entitlements are taken from the profiles.
