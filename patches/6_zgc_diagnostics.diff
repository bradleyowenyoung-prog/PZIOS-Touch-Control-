 #include <sys/mman.h>
+#include <errno.h>
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <mach/vm_map.h>
 
+// pziOS diagnostics: log every free gap of at least 1 GB between 1 GB and 1 TB, so we can see where a big reservation could ever fit.
+static void pzios_log_free_gaps() {
+  vm_address_t addr = (vm_address_t)1 << 30;
+  vm_address_t prev_end = addr;
+  int regions = 0, gaps = 0;
+  const vm_address_t limit = (vm_address_t)1 << 40;
+  while (addr < limit) {
+    vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    vm_address_t at = addr;
+    if (vm_region_64(mach_task_self(), &at, &size, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &object) != KERN_SUCCESS) {
+      break;
+    }
+    regions++;
+    if (at > prev_end && (at - prev_end) >= ((vm_address_t)1 << 30)) {
+      log_info_p(gc, init)("free gap: " PTR_FORMAT " - " PTR_FORMAT " (%lluM)", (uintptr_t)prev_end, (uintptr_t)at, (unsigned long long)((at - prev_end) >> 20));
+      gaps++;
+    }
+    prev_end = at + size;
+    addr = at + size;
+  }
+  if (limit > prev_end && (limit - prev_end) >= ((vm_address_t)1 << 30)) {
+    log_info_p(gc, init)("free gap: " PTR_FORMAT " - " PTR_FORMAT " (%lluM, to the 1 TB probe limit)", (uintptr_t)prev_end, (uintptr_t)limit, (unsigned long long)((limit - prev_end) >> 20));
+  }
+  log_info_p(gc, init)("address space survey: %d mapped regions above 1 GB, %d gaps of 1 GB or more before the last region", regions, gaps);
+}
+#endif
